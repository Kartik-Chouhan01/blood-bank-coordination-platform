# Copy to backend/.env and adjust. Never commit the real .env.

NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# MongoDB must run as a replica set (transactions are required for blood-unit allocation).
# Option A — zero-install local database: run `npm run dev:db` in another terminal, then use:
MONGODB_URI=mongodb://127.0.0.1:27017/bbms?replicaSet=rs0
# Option B — MongoDB Atlas (free tier is a replica set):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bbms?retryWrites=true&w=majority

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Set to the number of proxies in front of the API in production (e.g. 1 behind a load balancer).
TRUST_PROXY=0

# General API rate limit per IP, and a stricter one for login/registration/password reset.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20

# Public URL of the web app (used for links in verification / password-reset emails).
APP_URL=http://localhost:5173

# Authentication. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
# strict: web app and API on the same site (recommended; use a proxy/rewrite in production).
# none:   only for cross-site deployments (requires HTTPS).
COOKIE_SAMESITE=strict

# Days after a recorded donation before the system may contact a donor again (administrative
# policy set by the blood bank to match local regulations; not a medical eligibility rule).
DONOR_CONTACT_INTERVAL_DAYS=90
