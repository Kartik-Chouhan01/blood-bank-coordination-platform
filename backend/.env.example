# Copy to backend/.env and adjust. Never commit the real .env.

NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# MongoDB must run as a replica set (transactions are required for blood-unit allocation).
# Option A — zero-install local database: run `npm run dev:db` in another terminal, then use:
MONGODB_URI=mongodb://127.0.0.1:27017/bbms?replicaSet=rs0
# Option B — MongoDB Atlas (free tier is a replica set):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bbms?retryWrites=true&w=majority

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Set to the number of proxies in front of the API in production (e.g. 1 behind a load balancer).
TRUST_PROXY=0

# General API rate limit per IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
