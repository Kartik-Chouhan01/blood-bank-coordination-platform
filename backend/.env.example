# Copy to backend/.env and adjust. Never commit the real .env.

NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# MongoDB must run as a replica set (transactions are required for blood-unit allocation).
# Option A — zero-install local database: run `npm run dev:db` in another terminal, then use:
MONGODB_URI=mongodb://127.0.0.1:27017/bbms?replicaSet=rs0
# Option B — MongoDB Atlas (free tier is a replica set):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bbms?retryWrites=true&w=majority

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Set to the number of proxies in front of the API in production (e.g. 1 behind a load balancer).
TRUST_PROXY=0

# General API rate limit per IP, and a stricter one for login/registration/password reset.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20

# Public URL of the web app (used for links in verification / password-reset emails).
APP_URL=http://localhost:5173

# Authentication. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
# strict: web app and API on the same site (recommended; use a proxy/rewrite in production).
# none:   only for cross-site deployments (requires HTTPS).
COOKIE_SAMESITE=strict

# Policy defaults below can be changed later by administrators in System Settings (audited);
# these environment values are used until then.
# Email. `console` prints emails to the log (development). In production use `smtp` with your
# provider's SMTP URL (SES, SendGrid, Postmark, Mailgun, ...), and a verified sender address.
MAIL_TRANSPORT=console
# SMTP_URL=smtps://user:password@smtp.example.org:465
MAIL_FROM=DigiRakt <no-reply@localhost>

# Days after a recorded donation before the system may contact a donor again (administrative
# policy set by the blood bank to match local regulations; not a medical eligibility rule).
DONOR_CONTACT_INTERVAL_DAYS=90

# Shelf life overrides per component (days from collection). Defaults: WHOLE_BLOOD=35, PRBC=42,
# PLASMA=365, PLATELETS=5, CRYO=365. Set these to your local regulations, e.g.:
# SHELF_LIFE_DAYS=PLATELETS=7,PRBC=35
SHELF_LIFE_DAYS=
EXPIRY_WARNING_DAYS=3
EXPIRY_SWEEP_INTERVAL_MINUTES=5
JOBS_ENABLED=true

# Open requests stay "overdue" this many hours past required-by before they are closed as expired.
REQUEST_EXPIRY_GRACE_HOURS=2

# Matching. Reservations not issued within the hold are released automatically.
RESERVATION_HOLD_HOURS=24
# Donor outreach: search radius around the hospital (wider for emergencies), and how many potential
# donors to contact per missing unit, capped per request.
DONOR_SEARCH_RADIUS_KM=25
DONOR_SEARCH_RADIUS_EMERGENCY_KM=50
OUTREACH_DONORS_PER_UNIT=3
OUTREACH_MAX_DONORS=30

# Public stock levels (landing page): fewer than LOW_BELOW usable red-cell units of a group shows
# "Low", GOOD_FROM or more shows "Good". Exact counts are never published.
PUBLIC_STOCK_LOW_BELOW=5
PUBLIC_STOCK_GOOD_FROM=15
# Time zone used for dates in notification and email text, and for analytics buckets.
APP_TIME_ZONE=Asia/Kolkata
# Notifications are kept this many days, then deleted automatically.
NOTIFICATION_RETENTION_DAYS=180
