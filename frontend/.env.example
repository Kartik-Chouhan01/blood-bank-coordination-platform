# Copy to frontend/.env if you need to override defaults. Only VITE_-prefixed values reach the
# browser bundle, so never put secrets here.

# API base URL. Leave as /api in development (Vite proxies it to the backend on :5000).
VITE_API_BASE_URL=/api

# Phone number shown on the public emergency call-to-action. Leave empty to hide it.
VITE_EMERGENCY_HOTLINE=
