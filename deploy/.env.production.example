# Production settings for the API container (docker compose reads deploy/.env.production).
# Copy this file, fill in real values, and keep the copy out of version control.
# NODE_ENV, PORT, MONGODB_URI and TRUST_PROXY are set by docker-compose.yml.

# The public URL people open (used in email links) and the only browser origin allowed.
APP_URL=https://blood.example.org
CORS_ORIGINS=https://blood.example.org

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
# The web app and API share one origin behind nginx, so strict same-site cookies work.
COOKIE_SAMESITE=strict

LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20

# Email (required for verification, password reset and notification emails).
MAIL_TRANSPORT=smtp
SMTP_URL=smtps://user:password@smtp.example.org:465
MAIL_FROM=DigiRakt <no-reply@blood.example.org>

APP_TIME_ZONE=Asia/Kolkata
# The OpenAPI document is off in production unless you turn it on.
API_DOCS_ENABLED=false

# Policy defaults (administrators can change these later in System Settings; every change audited).
DONOR_CONTACT_INTERVAL_DAYS=90
SHELF_LIFE_DAYS=
EXPIRY_WARNING_DAYS=3
REQUEST_EXPIRY_GRACE_HOURS=2
RESERVATION_HOLD_HOURS=24
DONOR_SEARCH_RADIUS_KM=25
DONOR_SEARCH_RADIUS_EMERGENCY_KM=50
OUTREACH_DONORS_PER_UNIT=3
OUTREACH_MAX_DONORS=30
PUBLIC_STOCK_LOW_BELOW=5
PUBLIC_STOCK_GOOD_FROM=15
NOTIFICATION_RETENTION_DAYS=180
JOBS_ENABLED=true
EXPIRY_SWEEP_INTERVAL_MINUTES=5
